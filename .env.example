# enotes environment template
# Copy to .env.local for local development.
# NEVER commit .env.local or the VAPID private key.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# GIF search
GIPHY_API_KEY=YOUR_GIPHY_API_KEY
NEXT_PUBLIC_GIF_PROVIDER=giphy

# Web Push / PWA notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:enotes@example.com
PUSH_SEND_SECRET=YOUR_RANDOM_PUSH_SEND_SECRET

# Public production URL used by Supabase pg_net
NEXT_PUBLIC_SITE_URL=https://enotes-ph.vercel.app
\n# Cloudflare Turnstile (public site key only; keep the secret in Supabase Auth CAPTCHA settings)\nNEXT_PUBLIC_TURNSTILE_SITE_KEY=YOUR_CLOUDFLARE_TURNSTILE_SITE_KEY\n
# JSON2Video cloud rendering (server-side only)
JSON2VIDEO_API_KEY=YOUR_JSON2VIDEO_API_KEY

# Creatomate cloud rendering (server-side only)
CREATOMATE_API_KEY=YOUR_CREATOMATE_API_KEY

# ElevenLabs Studio audio/AI generation (server-side only)
ELEVENLABS_API_KEY=YOUR_ELEVENLABS_API_KEY
# Optional default voice used by AI narration
ELEVENLABS_VOICE_ID=YOUR_ELEVENLABS_VOICE_ID
