# enotes environment template
# Copy to .env.local for local development.
# NEVER commit .env.local or the VAPID private key.

NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# Web Push / PWA notifications
NEXT_PUBLIC_VAPID_PUBLIC_KEY=YOUR_VAPID_PUBLIC_KEY
VAPID_PRIVATE_KEY=YOUR_VAPID_PRIVATE_KEY
VAPID_SUBJECT=mailto:enotes@example.com
PUSH_SEND_SECRET=YOUR_RANDOM_PUSH_SEND_SECRET

# Public production URL used by Supabase pg_net
NEXT_PUBLIC_SITE_URL=https://enotes-amber.vercel.app
